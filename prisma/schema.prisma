generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CLIENT
}

enum ClientStatus {
  ACTIVE
  EXCLUDED
}

enum DebtStatus {
  ACTIVE
  SETTLED
  RENEGOTIATED
  EXCLUDED
}

enum DebtKind {
  STANDARD
  RENEGOTIATED
}

enum DebtType {
  LOAN
  INSTALLMENT_SALE
  SERVICE
  MANUAL_AGREEMENT
}

enum InterestMode {
  PERCENTAGE
  FIXED
}

enum PaymentType {
  JUROS
  PARCIAL
  TOTAL
  PARCELA
}

enum RenegotiationStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  cpf       String?  @unique
  password  String
  phone     String?
  avatarUrl String?
  role      UserRole @default(ADMIN)

  accountId Int
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  client    Client?
  auditLogs AuditLog[]
  openedSupportConversations SupportConversation[] @relation("SupportOpenedBy")
  supportMessages SupportMessage[] @relation("SupportSender")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Account {
  id             Int             @id @default(autoincrement())
  name           String
  inviteCode     String?         @unique
  settings       AccountSettings?
  subscriptions  Subscription[]
  auditLogs      AuditLog[]
  supportConversations SupportConversation[]
  supportMessages SupportMessage[]
  users          User[]
  clients        Client[]
  debts          Debt[]
  payments       Payment[]
  paymentIntents PaymentIntent[]
  saasPaymentIntents SaasPaymentIntent[]
  webhookLogs    WebhookLog[]
  backupSnapshots BackupSnapshot[]
  renegotiations Renegotiation[]
  installments   Installment[]
  installmentSplits InstallmentSplit[]

  creditRequests CreditRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model AccountSettings {
  id              Int      @id @default(autoincrement())
  company         Json     @default("{}")
  admin           Json     @default("{}")
  finance         Json     @default("{}")
  mercadoPago     Json     @default("{}")
  whatsapp        Json     @default("{}")
  saas            Json     @default("{}")
  appearance      Json     @default("{}")
  notifications   Json     @default("{}")
  security        Json     @default("{}")
  automation      Json     @default("{}")

  accountId       Int      @unique
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model Plan {
  id              Int      @id @default(autoincrement())
  code            String   @unique
  name            String
  description     String?
  priceCents      Int      @default(0)
  currency        String   @default("BRL")
  clientLimit     Int?
  billingPeriod   String   @default("MONTHLY")
  periodMonths    Int      @default(1)
  sortOrder       Int      @default(0)
  isPublic        Boolean  @default(true)
  features        Json     @default("[]")
  isActive        Boolean  @default(true)

  subscriptions   Subscription[]
  pendingSubscriptions Subscription[] @relation("PendingSubscriptionPlan")
  saasPaymentIntents SaasPaymentIntent[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model Subscription {
  id              Int      @id @default(autoincrement())
  status          String   @default("TRIAL")
  trialEndsAt     DateTime?
  currentPeriodEnd DateTime?
  externalProvider String?
  externalId      String?
  pendingPlanId   Int?
  pendingPlan     Plan?    @relation("PendingSubscriptionPlan", fields: [pendingPlanId], references: [id], onDelete: SetNull)
  pendingChangeAt DateTime?

  planId          Int
  plan            Plan     @relation(fields: [planId], references: [id])

  accountId       Int
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  saasPaymentIntents SaasPaymentIntent[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([accountId, status])
  @@index([pendingPlanId])
  @@index([pendingChangeAt])
}

model SaasPaymentIntent {
  id                    Int      @id @default(autoincrement())
  provider              String   @default("MERCADO_PAGO")
  status                String   @default("CREATED")
  amount                Float
  currency              String   @default("BRL")
  externalReference     String   @unique
  idempotencyKey        String   @unique
  mercadoPagoPaymentId  String?  @unique
  qrCode                String?
  qrCodeBase64          String?
  ticketUrl             String?
  rawResponse           Json?
  rawWebhook            Json?
  paidAt                DateTime?
  expiresAt             DateTime?
  lastCheckedAt         DateTime?

  planId          Int
  plan            Plan          @relation(fields: [planId], references: [id])

  subscriptionId  Int?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  accountId       Int
  account         Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([accountId, status])
  @@index([planId, status])
  @@index([subscriptionId, status])
}

model AuditLog {
  id              Int      @id @default(autoincrement())
  action          String
  entity          String?
  entityId        String?
  severity        String   @default("INFO")
  metadata        Json     @default("{}")
  ip              String?
  userAgent       String?

  accountId       Int
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  userId          Int?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([accountId, action])
}

model SupportConversation {
  id              Int      @id @default(autoincrement())
  subject         String?
  status          String   @default("OPEN")
  priority        String   @default("NORMAL")
  lastMessageAt   DateTime @default(now())

  accountId       Int
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  clientId        Int?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  openedByUserId  Int?
  openedByUser    User?    @relation("SupportOpenedBy", fields: [openedByUserId], references: [id], onDelete: SetNull)

  messages        SupportMessage[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([accountId, status, lastMessageAt])
  @@index([clientId, status])
}

model SupportMessage {
  id              Int      @id @default(autoincrement())
  body            String
  direction       String   @default("INTERNAL")
  channel         String   @default("IN_APP")
  attachmentUrl   String?
  deliveredAt     DateTime?
  readAt          DateTime?
  whatsappMessageId String?
  metadata        Json     @default("{}")

  conversationId  Int
  conversation    SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  accountId       Int
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  senderUserId    Int?
  senderUser      User?    @relation("SupportSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  clientId        Int?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([conversationId, createdAt])
}

model Client {
  id        Int          @id @default(autoincrement())
  name      String
  cpf       String?
  address   String?
  phone     String?
  email     String?
  avatarUrl String?
  notes     String?
  status    ClientStatus @default(ACTIVE)
  deletedAt DateTime?

  userId    Int?   @unique
  user      User?  @relation(fields: [userId], references: [id])

  accountId Int
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  debts          Debt[]
  payments       Payment[]
  paymentIntents PaymentIntent[]
  renegotiations Renegotiation[]
  installments   Installment[]
  installmentSplits InstallmentSplit[]
  creditRequests CreditRequest[]
  supportConversations SupportConversation[]
  supportMessages SupportMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([accountId, cpf])
  @@unique([accountId, email])
  @@index([accountId, status])
}

model Debt {
  id                    Int          @id @default(autoincrement())
  title                 String?
  kind                  DebtKind     @default(STANDARD)
  debtType              DebtType     @default(LOAN)
  status                DebtStatus   @default(ACTIVE)
  principalAmount       Float      @default(0)
  principalOutstanding  Float      @default(0)
  monthlyInterestMode   InterestMode?
  monthlyInterestValue  Float?
  dailyInterestMode     InterestMode?
  dailyInterestValue    Float?
  currentCycleInterestPaid Float     @default(0)
  borrowedAt            DateTime   @default(now())
  originalDueDate       DateTime   @default(now())
  dueDate               DateTime
  lastInterestPaidAt    DateTime?
  settledAt             DateTime?
  deletedAt             DateTime?

  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  accountId   Int
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  renegotiationId Int?
  renegotiation   Renegotiation? @relation(fields: [renegotiationId], references: [id])

  originDebtId Int?
  originDebt   Debt?   @relation("DebtOrigin", fields: [originDebtId], references: [id])
  childDebts   Debt[]  @relation("DebtOrigin")

  payments     Payment[]
  paymentIntents PaymentIntent[]
  installments Installment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([accountId, status, kind])
  @@index([clientId, status])
}

model Renegotiation {
  id                Int                  @id @default(autoincrement())
  status            RenegotiationStatus  @default(ACTIVE)
  originalTotal     Float
  multiplier        Float?
  negotiatedTotal   Float
  installmentCount  Int
  installmentAmount Float
  startedAt         DateTime
  firstDueDate      DateTime
  dailyInterestMode InterestMode?
  dailyInterestValue Float?
  note              String?
  sourceDebtIds     Json?
  completedAt       DateTime?

  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  accountId   Int
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  debts       Debt[]
  installments Installment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([accountId, status])
  @@index([clientId, status])
}

model Installment {
  id                Int               @id @default(autoincrement())
  installmentNumber Int
  amount            Float
  paidAmount        Float             @default(0)
  dueDate           DateTime
  paidAt            DateTime?
  status            InstallmentStatus @default(PENDING)
  note              String?

  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  accountId   Int
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  renegotiationId Int
  renegotiation   Renegotiation @relation(fields: [renegotiationId], references: [id], onDelete: Cascade)

  debtId      Int?
  debt        Debt?      @relation(fields: [debtId], references: [id])

  payments    Payment[]
  paymentIntents PaymentIntent[]
  splits      InstallmentSplit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([renegotiationId, installmentNumber])
  @@index([accountId, status])
}

model InstallmentSplit {
  id          Int               @id @default(autoincrement())
  splitNumber Int
  amount      Float
  paidAmount  Float             @default(0)
  dueDate     DateTime
  paidAt      DateTime?
  status      InstallmentStatus @default(PENDING)
  note        String?

  installmentId Int
  installment   Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  accountId   Int
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([installmentId, splitNumber])
  @@index([accountId, status])
  @@index([clientId, dueDate])
}

model CreditRequest {
  id          Int      @id @default(autoincrement())
  amount      Float
  description String?
  desiredTermDays Int?
  requestedInstallments Int?
  decisionNote String?
  reviewedAt DateTime?
  approvedDebtId Int?
  approvedRenegotiationId Int?
  type        String
  status      String   @default("PENDING")

  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  accountId   Int
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

model Payment {
  id              Int         @id @default(autoincrement())
  type            PaymentType
  amount          Float
  principalAmount Float       @default(0)
  interestAmount  Float       @default(0)
  dailyAmount     Float       @default(0)
  note            String?
  receiptUrl      String?
  paidAt          DateTime    @default(now())
  deletedAt       DateTime?

  clientId        Int
  client          Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  debtId          Int?
  debt            Debt?       @relation(fields: [debtId], references: [id])

  installmentId   Int?
  installment     Installment? @relation(fields: [installmentId], references: [id])

  accountId       Int
  account         Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  paymentIntents  PaymentIntent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([accountId, type])
  @@index([clientId, paidAt])
  @@index([debtId, paidAt])
  @@index([accountId, deletedAt])
}

model PaymentIntent {
  id                    Int      @id @default(autoincrement())
  provider              String   @default("MERCADO_PAGO")
  kind                  String   @default("INSTALLMENT_PIX")
  status                String   @default("CREATED")
  amount                Float
  currency              String   @default("BRL")
  externalReference     String   @unique
  idempotencyKey        String   @unique
  mercadoPagoPaymentId  String?  @unique
  qrCode                String?
  qrCodeBase64          String?
  ticketUrl             String?
  rawResponse           Json?
  rawWebhook            Json?
  paidAt                DateTime?
  expiresAt             DateTime?
  lastCheckedAt         DateTime?

  clientId        Int
  client          Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  debtId          Int
  debt            Debt         @relation(fields: [debtId], references: [id])

  installmentId   Int
  installment     Installment  @relation(fields: [installmentId], references: [id])

  paymentId       Int?
  payment         Payment?     @relation(fields: [paymentId], references: [id])

  accountId       Int
  account         Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([accountId, status])
  @@index([clientId, status])
  @@index([installmentId, status])
}

model WebhookLog {
  id              Int      @id @default(autoincrement())
  provider        String   @default("MERCADO_PAGO")
  eventType       String?
  eventId         String?
  resourceId      String?
  signatureValid  Boolean  @default(false)
  processed       Boolean  @default(false)
  processingError String?
  headers         Json?
  payload         Json?

  accountId       Int?
  account         Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([provider, resourceId])
  @@index([processed, createdAt])
}

model BackupSnapshot {
  id              Int      @id @default(autoincrement())
  kind            String   @default("MANUAL")
  status          String   @default("COMPLETED")
  scope           String   @default("GLOBAL")
  fileName        String
  payload         Json
  counts          Json     @default("{}")
  metadata        Json     @default("{}")
  sizeBytes       Int      @default(0)
  errorMessage    String?

  accountId       Int?
  account         Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  createdByUserId Int?
  createdByEmail  String?
  restoredAt      DateTime?
  restoredByEmail String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([scope, kind, createdAt])
  @@index([accountId, createdAt])
}
